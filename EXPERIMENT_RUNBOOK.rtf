\pard\li360\sa0\f1\fs18\cf3   > evaluate/k8s/run_logs_$(date +%F)/exp7_bm25_expansion.log\par
\pard\li360\sa0\f1\fs18\cf3 tail -10 evaluate/k8s/run_logs_$(date +%F)/exp7_bm25_expansion.log\par
\pard\sa140\f0\fs22\cf1\par
