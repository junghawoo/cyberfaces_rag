.env
# Ignore ChromaDB local database and binaries
chromaDB/
*.sqlite3
*.bin

# Raw source attachments (2.1 GB) -- regenerate courses_md/ from these with
# extract_courses_full.py. The extracted markdown IS tracked; this is not.
courses/
summaries.zip

# Python bytecode
__pycache__/
*.pyc
anvil.yaml

# Regenerable evaluation outputs (produced by evaluate/*.py)
run_results/
run_results_gte_jina/
run_results_query_rewrites/
run_results_sample30/

# macOS / local agent config
.DS_Store
.claude/settings.local.json

# Point-in-time ConfigMap exports: regenerate from the manifests' comment blocks
# instead (an earlier export shipped the stale pre-D2 flatten_ab_eval.py).
evaluate/k8s/configmaps/

# Regenerable OCR/network cache written by extract_courses_full.py
courses_md/.cache/
